# PerfectMarkD configuration
#
#   cp .env.example .env
#
# Fill in the four secrets — the stack will not start without them — plus
# ADMIN_EMAIL so you can log in as Admin. Everything else has a working
# default and can be left alone.
#
# This file is never committed. Do not paste real keys into it.

# ── Secrets ────────────────────────────────────────────────────────────────────
# Generate all four with:
#
#   for k in SESSION_SECRET HISTORY_ENCRYPTION_KEY UMAMI_APP_SECRET \
#            UMAMI_DB_PASSWORD; do echo "$k=$(openssl rand -hex 32)"; done

# Signs login cookies.
SESSION_SECRET=

# Encrypts Premium Export History at rest. Changing it after exports exist
# makes every previously exported file permanently unreadable.
HISTORY_ENCRYPTION_KEY=

# Signs Umami's own login tokens.
UMAMI_APP_SECRET=

# Password for the analytics database.
UMAMI_DB_PASSWORD=

# ── Your instance ─────────────────────────────────────────────────────────────

# The first account registered with this address becomes the Admin. Register
# with exactly this address or nothing gets the flag.
ADMIN_EMAIL=

# AI Actions: your provider's API key. Leave it empty and the AI features do
# not exist in the UI at all. Changing it needs an api restart.
# The model, limits and kill switch are set in Admin → Settings, not here.
AI_API_KEY=

# Analytics website id, copied from Umami. Leave empty at first — you get it
# once the stack is up, following the Analytics section of the README. Empty
# means no analytics.
ANALYTICS_WEBSITE_ID=

# ── Only if the defaults don't fit your machine ───────────────────────────────

# Where Caddy publishes. 80 suits most hosts; if something already serves :80
# (nginx, another stack), give Caddy a different port and point your tunnel
# or proxy at it.
CADDY_HTTP_PORT=8901

# The HTTPS port, published next to it. Under rootless podman this must be 1024
# or higher: the kernel refuses unprivileged binds below that, so the default 443
# fails with "rootlessport cannot expose privileged port 443". To keep 443
# itself, set net.ipv4.ip_unprivileged_port_start=443 in /etc/sysctl.d and run
# `sudo sysctl --system`. Caddy only listens here once SITE_ADDRESS names a
# domain — the default ":80" is plain HTTP.
CADDY_HTTPS_PORT=8443

# Simultaneous Server Export renders. Each one is a headless Chromium needing
# roughly a gigabyte, and the default is two at once. Set this to 1 on a
# machine with less than about 4 GB free.
#EXPORT_CONCURRENCY=2

# ── Backups, off by default ───────────────────────────────────────────────────

# Nothing at all is backed up until this is 1. With backups off there is no
# way to recover your database or your Export History.
#BACKUP_ENABLED=0

# Where to upload. Leave empty to keep the backup on this machine only —
# which still covers accidents, but not losing the machine.
#BACKUP_REMOTE=b2:perfectmarkd-backups

# ── Rarely changed ────────────────────────────────────────────────────────────

# Pin the exact api and caddy images this deployment runs. `latest` follows
# every push to main; a `sha-…` tag pins a known-good pair.
#PERFECTMARKD_IMAGE_TAG=latest

# Set this to a domain only for a host exposed directly to the internet. Leave
# it alone behind a tunnel, which terminates TLS itself.
#SITE_ADDRESS=:80

# ── Development only ──────────────────────────────────────────────────────────
# Docker Compose sets its own database paths, so these stay commented out
# unless you are running the servers directly with `pnpm dev`.
#PORT=3000
#DB_PATH=./data/perfectmarkd.db
#HISTORY_DIR=./data/history
