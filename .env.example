# PerfectMarkD API configuration — copy to .env (never committed) and fill in.
# In Docker/Compose these are passed as environment variables instead.

# Port the API listens on.
PORT=3000

# SQLite database file; the parent directory is created if missing.
DB_PATH=./data/perfectmarkd.db

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# First registered account with this email becomes the Admin (bootstrap).
ADMIN_EMAIL=

# Server Export (server/03): origin the worker loads /export from — the web
# dev server in development (default http://localhost:3000, this API's own
# port; docker compose sets it to http://caddy, a loopback origin on the
# compose network that serves the SPA regardless of public TLS).
#EXPORT_ORIGIN=http://localhost:5173

# Simultaneous export renders.
#EXPORT_CONCURRENCY=2

# Max exports one user may enqueue per rolling minute.
#EXPORT_BURST_PER_MINUTE=10

# Per-render deadline in milliseconds before a job fails as render_timeout.
#EXPORT_RENDER_TIMEOUT_MS=120000

# Export History (server/05): where finished Premium users' Server Exports
# are kept, encrypted at rest. Must be outside any web root. Required — the
# API refuses to boot without it, because Premium users' exports are
# supposed to be retained.
HISTORY_ENCRYPTION_KEY=

# Root directory for the encrypted history files (default ./data/history).
#HISTORY_DIR=./data/history

# AI Actions (ADR-0008): the provider's API key. It belongs to the deployment
# and is read from the environment only — never written to the settings table,
# never returned by an endpoint, never logged. Rotating it needs a restart.
# Leave unset for no AI: a fresh instance reports AI as unavailable until a
# key is present, and the Admin panel only ever reports whether one is set.
#AI_API_KEY=

# Compose (server/06): address Caddy serves the site on. ":80" is plain HTTP
# for local runs; a domain gives automatic TLS via Let's Encrypt (launch/04).
#SITE_ADDRESS=:80

# Host ports published by Caddy. Override only when the low ports are taken
# or unavailable (rootless container daemons cannot bind below 1024).
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443

# Backups (launch/03): rclone remote:path the nightly job (ops/backup.sh)
# uploads to, e.g. "b2:perfectmarkd-backups" once `rclone config` has the
# remote. A plain absolute path also works (used by the restore rehearsal in
# docs/ops/restore.md). Unset = the backup job refuses to run.
#BACKUP_REMOTE=b2:perfectmarkd-backups

# Where the nightly job stages dumps before upload (default below).
#BACKUP_STAGE=/var/backups/perfectmarkd
