# PerfectMarkD API configuration — copy to .env (never committed) and fill in.
# In Docker/Compose these are passed as environment variables instead.

# Port the API listens on.
PORT=3000

# SQLite database file; the parent directory is created if missing.
DB_PATH=./data/perfectmarkd.db

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# First registered account with this email becomes the Admin (bootstrap).
ADMIN_EMAIL=

# Server Export (server/03): origin the worker loads /export from — the web
# dev server in development (default http://localhost:3000, this API's own
# port; in production server/06 serves the SPA on the same origin).
#EXPORT_ORIGIN=http://localhost:5173

# Simultaneous export renders.
#EXPORT_CONCURRENCY=2

# Max exports one user may enqueue per rolling minute.
#EXPORT_BURST_PER_MINUTE=10

# Per-render deadline in milliseconds before a job fails as render_timeout.
#EXPORT_RENDER_TIMEOUT_MS=120000
