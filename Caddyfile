# PerfectMarkD static serving (server/06): the Caddy container serves the
# SPA baked into its image at /srv, reverse-proxies the API paths to the
# api container, and reverse-proxies /analytics to the umami container
# (launch/01). One config, imported by two site blocks:
#
#   {$SITE_ADDRESS} — the public origin; ":80" for the shipped deployment,
#     where a Cloudflare Tunnel terminates TLS in front of Caddy (ADR-0010).
#     A domain instead gets Caddy's own automatic TLS, which is only right
#     for a directly-exposed host (rollout docs: launch/04).
#   http://caddy   — loopback origin on the compose network: the export
#     worker loads the app's own /export page from here (EXPORT_ORIGIN),
#     plain HTTP regardless of how the public site is served.
#
# The admin UI is just another SPA route; admin *API* calls ride /api/admin
# through the same proxy, gated server-side by is_admin.

(serve) {
	encode zstd gzip

	# Vite ships content-hashed filenames under /assets — cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The hidden /export page is the worker's render surface, not content —
	# keep it out of search indexes (spec: security posture).
	header /export* X-Robots-Tag "noindex"

	# This instance's analytics id (launch/11), handed to the app at runtime so
	# that one published image serves every instance: the id is a deployment
	# setting, not a build input, and an empty value turns analytics off
	# entirely. Caddy evaluates the mutually-exclusive `handle` blocks in an
	# order it derives itself, and a path-matched one sorts ahead of the bare
	# SPA fallback below — which would otherwise answer this path with
	# index.html, and a browser handed HTML where it expects JavaScript fails
	# to parse it on every page load. (Verified with `caddy adapt`: moving this
	# block after the fallback does not change the resulting order.)
	handle /analytics-config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		respond "window.__ANALYTICS_WEBSITE_ID__ = \"{$ANALYTICS_WEBSITE_ID:}\";"
	}

	# Self-hosted analytics (launch/01) sit under /analytics on this origin.
	# The prefix is passed through untouched: the Umami image bakes that base
	# path in, so it expects to see it. The tracker endpoints (/script.js,
	# /api/send) are public by necessity — they are what collects the events —
	# while the dashboard behind them needs the Admin's own Umami account.
	@analytics path /analytics /analytics/*
	handle @analytics {
		reverse_proxy {$UMAMI_UPSTREAM:umami:3000}
	}

	# API (auth, billing, admin, export, history) and the health probe go to
	# the api container; everything else is the SPA.
	@backend path /api /api/* /healthz
	handle @backend {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# SPA fallback: deep links like /pricing, /login and /export all serve
	# index.html; the router picks the page client-side.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS::80} {
	import serve
}

http://caddy {
	import serve
}
