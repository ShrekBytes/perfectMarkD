node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Local SQLite data (default DB_PATH)
data/
*.db
*.db-wal
*.db-shm

# OS / editor noise
.DS_Store
*.log

# Agent working state (prodready scans, their judgements and question sets).
